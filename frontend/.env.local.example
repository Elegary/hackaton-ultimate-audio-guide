# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit your real key.

# Google Maps JavaScript API key
# Restrict in GCP to: HTTP referrers (*.vercel.app/*, localhost:5173/*) + Maps JS API
VITE_GOOGLE_MAPS_API_KEY=

# Backend WebSocket URL (filled later when the backend is up)
# VITE_BACKEND_WS_URL=wss://orient-backend.railway.app
